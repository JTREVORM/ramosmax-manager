{
  "name": "ramosmax-functions",
  "private": true,
  "type": "module",
  "description": "RamosMAX trusted server code: user administration and access control.",
  "main": "src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "test:unit": "node --test test/access.test.js",
    "test:emulated": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "test": "firebase emulators:exec --project demo-ramosmax --only auth,firestore,storage \"npm run test:emulated\"",
    "deploy:dev": "firebase deploy --project development --only functions",
    "deploy:prod": "firebase deploy --project production --only functions"
  },
  "dependencies": {
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0"
  }
}
