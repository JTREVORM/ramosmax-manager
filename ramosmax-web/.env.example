# RamosMAX Web — environment
#
# Copy to .env.local for local work, or set these in Vercel for a deployment.
# NEVER point a deployment at a production project during migration
# development, and never commit .env.local.
#
# Which of these are REQUIRED depends on what you are doing:
#
#   local, no Supabase project   DATABASE_URL only
#   deployed against Supabase    DATABASE_URL, the three SUPABASE vars,
#                                SESSION_SECRET
#
# Everything below those is optional and can be added later.

# ---------------------------------------------------------------------------
# The database — ALWAYS required
# ---------------------------------------------------------------------------
# Where the data is read and written. Locally this is a PostgreSQL database on
# your machine; in a deployment it is the Supabase project's own connection
# string.
#
# For Vercel use the POOLED (Supavisor) string, not the direct one: a
# serverless deployment opens many short-lived connections and the direct
# endpoint will run out. Supabase dashboard → Connect → Transaction pooler.
#
#   local     postgres://postgres:devonly@127.0.0.1:5432/ramosmax_dev
#   Supabase  postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Every read taken through this connection immediately drops to the
# `authenticated` role and sets the caller's claims, so RLS decides what comes
# back exactly as it would for a direct client query.
DATABASE_URL=

# How many connections each running instance may hold. Leave it alone unless
# the pooler starts refusing connections.
# DATABASE_POOL_MAX=5

# ---------------------------------------------------------------------------
# Supabase — required for a deployment
# ---------------------------------------------------------------------------
# These decide WHERE PASSWORDS LIVE. With them set, credentials are Supabase
# Auth's (GoTrue); without them, they are bcrypt hashes in a local auth.users,
# which is how the development database works with no hosted project.

# Safe to expose to the browser. Bounded by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Bypasses RLS entirely. It must NEVER be prefixed NEXT_PUBLIC_, must
# never be imported into a Client Component, and is used only by the server
# for the credential store: creating a sign-in identity, setting a password,
# ending sessions.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Sessions — required for a deployment
# ---------------------------------------------------------------------------
# Signs the session cookie. Any long random string; generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everybody out. The application refuses to start a
# production build with a Supabase project and no secret set.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Web Push — optional
# ---------------------------------------------------------------------------
# Generate a pair with:  npx web-push generate-vapid-keys
# The PUBLIC key is handed to the browser so it can subscribe, and the server
# signs with the same key — they must match, which is why there is only one.
# The PRIVATE key signs the pushes and must never leave the server. Without
# them the in-app inbox still works and notices simply wait to be read.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# The "who to contact about this push" address, as the Web Push spec requires.
VAPID_SUBJECT=mailto:admin@example.com

# ---------------------------------------------------------------------------
# Notification delivery — optional
# ---------------------------------------------------------------------------
# A shared secret for POST /api/notifications/deliver, which turns events into
# notices and sends the pushes. Give it to the scheduler and to nobody else.
# Without it the endpoint answers 503 and refuses to run at all. Notices are
# still written; they are simply delivered when something calls this.
NOTIFICATION_CRON_SECRET=

# ---------------------------------------------------------------------------
# Setup and verification only — never set these in Vercel
# ---------------------------------------------------------------------------
# The DIRECT (non-pooled) connection string, used by
# scripts/apply-migrations.mjs, scripts/bootstrap-admin.mjs and
# scripts/check-supabase.mjs. These run from your machine, not from the
# deployment.
# SUPABASE_DB_URL=
# SUPABASE_POOLED_URL=
